# VendorPulse Configuration Environment Variables

# Backend API Settings
PORT=8000
HOST=0.0.0.0
DEBUG=True
DATABASE_URL=sqlite:///./vendorpulse.db

# OpenWeatherMap API (One Call API 3.0 / 2.5)
# Register at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Google Maps Routes / Traffic API
# Obtain at: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Local News / Scraper Settings (Ada Derana / NewsFirst RSS)
SCRAPER_USER_AGENT=VendorPulse-Research-Bot/1.0
INGESTION_INTERVAL_MINUTES=180

# Supabase (Optional for cloud sync; SQLite is active by default)
SUPABASE_URL=
SUPABASE_KEY=
